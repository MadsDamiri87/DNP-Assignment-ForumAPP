# Kør requestene oppefra og ned. Hvert trin gemmer id'er og tokens i variabler,
# så intet forudsætter, at databasen allerede har bestemte rækker.
# Forfatteren bestemmes af tokenet, ikke af et felt i bodyen.

@HostAddress = http://localhost:5028

### 1 - Opret alice
# @name createAlice
POST {{HostAddress}}/users
Content-Type: application/json

{
  "userName": "alice",
  "password": "secret",
  "email": "alice@x.dk"
}

> {% client.global.set("aliceId", response.body.id); %}

### 2 - Opret bob
# @name createBob
POST {{HostAddress}}/users
Content-Type: application/json

{
  "userName": "bob",
  "password": "secret",
  "email": "bob@x.dk"
}

> {% client.global.set("bobId", response.body.id); %}

### 3 - Uden token. Forventet: 401
GET {{HostAddress}}/users
Accept: application/json

### 4 - Log ind som alice. Svaret er et JWT
# @name loginAlice
POST {{HostAddress}}/auth/login
Content-Type: application/json

{
  "userName": "alice",
  "password": "secret"
}

> {% client.global.set("aliceToken", response.body); %}

### 5 - Log ind som bob
# @name loginBob
POST {{HostAddress}}/auth/login
Content-Type: application/json

{
  "userName": "bob",
  "password": "secret"
}

> {% client.global.set("bobToken", response.body); %}

### 6 - Med token. Forventet: 200
GET {{HostAddress}}/users
Accept: application/json
Authorization: Bearer {{aliceToken}}

### 7 - Filtrér brugere på del af brugernavn
GET {{HostAddress}}/users?userNameContains=ali
Accept: application/json
Authorization: Bearer {{aliceToken}}

### 8 - Hent alice
GET {{HostAddress}}/users/{{aliceId}}
Accept: application/json
Authorization: Bearer {{aliceToken}}

### 9 - Opret subforum. Alice bliver creator ud fra tokenet
# @name createSubForum
POST {{HostAddress}}/subforums
Content-Type: application/json
Authorization: Bearer {{aliceToken}}

{
  "name": "cats",
  "description": "Everything about cats"
}

> {% client.global.set("subForumId", response.body.id); %}

### 10 - Filtrér subforums på navn
GET {{HostAddress}}/subforums?nameContains=cat
Accept: application/json

### 11 - Opret post. Alice bliver forfatter ud fra tokenet
# @name createPost
POST {{HostAddress}}/posts
Content-Type: application/json
Authorization: Bearer {{aliceToken}}

{
  "title": "My first post",
  "body": "Hello forum",
  "subForumId": {{subForumId}}
}

> {% client.global.set("postId", response.body.id); %}

### 12 - Filtrér posts på titel og forfatter-id
GET {{HostAddress}}/posts?titleContains=first&userId={{aliceId}}
Accept: application/json

### 13 - Filtrér posts på forfatternavn og subforum
GET {{HostAddress}}/posts?userNameContains=ali&subForumId={{subForumId}}
Accept: application/json

### 14 - Hent posten
GET {{HostAddress}}/posts/{{postId}}
Accept: application/json

### 15 - Opdatér posten. PUT er en fuld erstatning, så alle felter skal med
PUT {{HostAddress}}/posts/{{postId}}
Content-Type: application/json
Authorization: Bearer {{aliceToken}}

{
  "title": "My first post (edited)",
  "body": "Hello forum",
  "subForumId": {{subForumId}}
}

### 16 - Posts i subforummet
GET {{HostAddress}}/subforums/{{subForumId}}/posts
Accept: application/json

### 17 - Bob kommenterer alices post
# @name createComment
POST {{HostAddress}}/comments
Content-Type: application/json
Authorization: Bearer {{bobToken}}

{
  "body": "Nice post",
  "postId": {{postId}}
}

> {% client.global.set("commentId", response.body.id); %}

### 18 - Kommentarer på posten
GET {{HostAddress}}/posts/{{postId}}/comments
Accept: application/json

### 19 - Filtrér kommentarer på post og bruger
GET {{HostAddress}}/comments?postId={{postId}}&userId={{bobId}}
Accept: application/json

### 20 - Bob retter sin egen kommentar
PUT {{HostAddress}}/comments/{{commentId}}
Content-Type: application/json
Authorization: Bearer {{bobToken}}

{
  "body": "Nice post (edited)"
}

### 21 - Alice prøver at rette bobs kommentar. Forventet: 403
PUT {{HostAddress}}/comments/{{commentId}}
Content-Type: application/json
Authorization: Bearer {{aliceToken}}

{
  "body": "Not my comment"
}

### 22 - Ukendt post. Forventet: 404
GET {{HostAddress}}/posts/999999
Accept: application/json

### 23 - Alice sletter posten. Kommentarerne forsvinder med
DELETE {{HostAddress}}/posts/{{postId}}
Authorization: Bearer {{aliceToken}}

### 24 - Alice sletter subforummet
DELETE {{HostAddress}}/subforums/{{subForumId}}
Authorization: Bearer {{aliceToken}}

### 25 - Alice sletter sin egen konto. Soft delete, så indhold bevares
DELETE {{HostAddress}}/users/{{aliceId}}
Authorization: Bearer {{aliceToken}}

### 26 - Alices gamle token afvises nu. Forventet: 401
GET {{HostAddress}}/users
Accept: application/json
Authorization: Bearer {{aliceToken}}
