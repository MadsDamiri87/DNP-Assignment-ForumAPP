@if (IsOpen)
{
    <div class="account-scrim">
        <button class="account-dismiss" type="button" aria-label="Close the account dialog"
                @onclick="OnClose"></button>

        <div class="account-dialog" role="dialog" aria-modal="true" aria-label="Account">
            <button class="account-close" type="button" aria-label="Close" @onclick="OnClose">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8"/>
                </svg>
            </button>

            <AccountForm SignUp="SignUp" SignUpChanged="SignUpChanged" OnSignedIn="OnSignedIn"/>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool SignUp { get; set; }

    [Parameter]
    public EventCallback<bool> SignUpChanged { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSignedIn { get; set; }
}
