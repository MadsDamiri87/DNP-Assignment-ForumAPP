@page "/subforums/create"
@attribute [Authorize]
@inject ISubForumApiService SubForumApiService
@inject NavigationManager NavigationManager

<PageTitle>New sub-forum</PageTitle>

<h1>New sub-forum</h1>

<div class="mb-3">
    <label class="form-label" for="name">Name</label>
    <input id="name" class="form-control" @bind="name"/>
</div>

<div class="mb-3">
    <label class="form-label" for="description">Description</label>
    <textarea id="description" class="form-control" rows="3" @bind="description"></textarea>
</div>

<button class="btn btn-primary" @onclick="CreateSubForumAsync" disabled="@isSaving">Create sub-forum</button>
<a class="btn btn-secondary" href="subforums">Cancel</a>

@if (saveError is not null)
{
    <div class="alert alert-danger mt-3">@saveError</div>
}

@code {
    private string name = string.Empty;
    private string description = string.Empty;

    private string? saveError;
    private bool isSaving;

    private async Task CreateSubForumAsync()
    {
        saveError = null;
        isSaving = true;

        try
        {
            CreateSubForumDto request = new()
            {
                Name = name,
                Description = description
            };

            await SubForumApiService.AddAsync(request);
            NavigationManager.NavigateTo("subforums");
        }
        catch (Exception e)
        {
            saveError = e.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
