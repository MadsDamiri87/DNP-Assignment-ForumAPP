@page "/login"
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<div class="login-page">
    <div class="panel login-panel">
        <AccountForm SignUp="signUp" SignUpChanged="OnSignUpChanged" OnSignedIn="GoHome"/>
    </div>
</div>

@code {
    private bool signUp;

    private void OnSignUpChanged(bool value) => signUp = value;

    private void GoHome() => NavigationManager.NavigateTo("");
}
