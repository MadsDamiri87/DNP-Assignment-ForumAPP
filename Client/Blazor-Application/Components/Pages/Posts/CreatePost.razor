@page "/posts/create"
@inject IPostService PostService
@inject IUserService UserService
@inject ISubForumService SubForumService
@inject NavigationManager NavigationManager

<PageTitle>New post</PageTitle>

<h1>New post</h1>

@if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (users.Count == 0)
{
    <div class="alert alert-warning">
        There are no users yet. <a href="users/create">Create a user</a> before writing a post.
    </div>
}
else
{
    <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input id="title" class="form-control" @bind="title"/>
    </div>

    <div class="mb-3">
        <label class="form-label" for="body">Body</label>
        <textarea id="body" class="form-control" rows="6" @bind="body"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label" for="author">Author</label>
        <select id="author" class="form-select" @bind="userId">
            @foreach (UserDto user in users)
            {
                <option value="@user.Id">@user.UserName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label" for="subForum">Sub-forum</label>
        <select id="subForum" class="form-select" @bind="subForumId">
            <option value="0">None</option>
            @foreach (SubForumDto subForum in subForums)
            {
                <option value="@subForum.Id">@subForum.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-primary" @onclick="CreatePostAsync" disabled="@isSaving">Create post</button>
    <a class="btn btn-secondary" href="posts">Cancel</a>

    @if (saveError is not null)
    {
        <div class="alert alert-danger mt-3">@saveError</div>
    }
}

@code {
    private List<UserDto> users = [];
    private List<SubForumDto> subForums = [];

    private string title = string.Empty;
    private string body = string.Empty;
    private int userId;
    private int subForumId;

    private string? loadError;
    private string? saveError;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await UserService.GetUsersAsync();
            subForums = await SubForumService.GetSubForumsAsync();

            if (users.Count > 0)
            {
                userId = users[0].Id;
            }
        }
        catch (Exception e)
        {
            loadError = e.Message;
        }
    }

    private async Task CreatePostAsync()
    {
        saveError = null;
        isSaving = true;

        try
        {
            CreatePostDto request = new()
            {
                Title = title,
                Body = body,
                UserId = userId,
                SubForumId = subForumId == 0 ? null : subForumId
            };

            PostDto created = await PostService.AddAsync(request);
            NavigationManager.NavigateTo($"posts/{created.Id}");
        }
        catch (Exception e)
        {
            saveError = e.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
