@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Forum</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="posts">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Posts
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="subforums">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sub-forums
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Users
            </NavLink>
        </div>

        <hr class="text-white-50"/>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 py-2 text-white-50">
                    Signed in as <span class="fw-semibold text-white">@context.User.Identity?.Name</span>
                </div>

                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start" @onclick="LogoutAsync">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Log out
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Log in
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("");
    }
}
