<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">
            <img class="brand-logo" src="images/logo-dnp.png" alt="DNP"/>
        </a>

        <nav class="topbar-nav">
            <NavLink class="topbar-link" href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="topbar-link" href="posts">Posts</NavLink>
            <NavLink class="topbar-link" href="subforums">Forums</NavLink>
            <NavLink class="topbar-link" href="users">Users</NavLink>
        </nav>

        <div class="topbar-actions">
            <NavLink class="icon-btn" href="search" aria-label="Search the forum">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <circle cx="8.75" cy="8.75" r="5.25"/>
                    <path d="m12.75 12.75 4 4"/>
                </svg>
            </NavLink>

            <AuthorizeView>
                <Authorized>
                    <a class="pill-btn pill-btn-accent" href="posts/create">New post</a>
                </Authorized>
                <NotAuthorized>
                    <button class="pill-btn pill-btn-ghost" type="button" @onclick="OpenLogin">Log in</button>
                    <button class="pill-btn pill-btn-accent" type="button" @onclick="OpenSignUp">Create account</button>
                </NotAuthorized>
            </AuthorizeView>

            <UserMenu/>
        </div>
    </div>
</header>

<AccountDialog IsOpen="isDialogOpen" SignUp="signUp" SignUpChanged="OnSignUpChanged"
               OnClose="CloseDialog" OnSignedIn="CloseDialog"/>

@code {
    private bool isDialogOpen;
    private bool signUp;

    private void OpenLogin()
    {
        signUp = false;
        isDialogOpen = true;
    }

    private void OpenSignUp()
    {
        signUp = true;
        isDialogOpen = true;
    }

    private void OnSignUpChanged(bool value) => signUp = value;

    private void CloseDialog() => isDialogOpen = false;
}
